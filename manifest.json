{
  "manifest_version": 3,
  "name": "YouTube Scroll to Skip",
  "version": "1.1.0",
  "description": "Scroll up/down over a YouTube video to skip forward or backward. Click the icon to turn it on or off.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "YouTube Scroll to Skip: click to turn on/off",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-scroll-skip@zetterstrom",
      "strict_min_version": "121.0"
    }
  }
}
