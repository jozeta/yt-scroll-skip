{
  "manifest_version": 3,
  "name": "YouTube Scroll to Skip",
  "version": "1.0",
  "description": "Scroll up/down to skip forward or backward 10 seconds on YouTube videos.",
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
